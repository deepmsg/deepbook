# The four machines of the cluster test.
#
#   node0/1/2  one cluster member each (driver + consensus module + container)
#   client     that member's own driver, the FIX gateway and the load client
#
# Every value is a default that the environment can override before this file
# is sourced. The addresses are the VPC ones; the controller is node0, so the
# other three are reached from there.
#
# ★ The public address of node0 is not stable across a stop/start; this file
# only ever names the private ones.

CLUSTER_NODE0_SSH=${CLUSTER_NODE0_SSH:-root@172.16.1.15}
CLUSTER_NODE1_SSH=${CLUSTER_NODE1_SSH:-root@172.16.1.19}
CLUSTER_NODE2_SSH=${CLUSTER_NODE2_SSH:-root@172.16.1.20}
CLUSTER_CLIENT_SSH=${CLUSTER_CLIENT_SSH:-root@172.16.1.17}

CLUSTER_ID=${CLUSTER_ID:-7}

# ★ The ports sit below Linux's ephemeral range (32768-60999) on purpose: a
# fixed port inside it can be taken by any process between two runs, and a
# cluster that loses one of its own endpoints fails in a way that looks like a
# bug in the cluster.
#
#   ingress      base + member        base + 0..2
#   consensus    base + 10 + member   base + 10..12
#   log          base + 20 + member   base + 20..22
#   egress       base + 30            (client's own response channel is :0)
#   archive      base + 40 + member   base + 40..42
#   client archive base + 43
#   FIX          base + 50
CLUSTER_BASE_PORT=${CLUSTER_BASE_PORT:-25000}

# Where the binaries live on every host.
CLUSTER_DEEPMSG_DIR=${CLUSTER_DEEPMSG_DIR:-/root/deepbook/deepmsg}
CLUSTER_DEEPBOOK_DIR=${CLUSTER_DEEPBOOK_DIR:-/root/deepbook/deepbook}

# Everything a run writes. `up` removes it; `down` stops what is in it.
CLUSTER_RUN_ROOT=${CLUSTER_RUN_ROOT:-/root/deepbook/cluster-4host}

# Where the processes write their JSON logs. ★ Outside `CLUSTER_RUN_ROOT` on
# purpose: `up` removes the run root, and a log that disappears with the run it
# describes cannot answer what happened. The launcher creates it; the collector
# reads it as another user, so it must stay world-readable. Empty means the
# application logs stay off (the variables are simply not exported).
CLUSTER_LOG_DIR=${CLUSTER_LOG_DIR-/var/log/deepmsg}
CLUSTER_LOG_LEVEL=${CLUSTER_LOG_LEVEL:-info}
# `<size>:<file count>`; empty keeps the facade's own default.
CLUSTER_LOG_ROLL=${CLUSTER_LOG_ROLL:-}
# ★ The driver's term buffers and CnC, on a tmpfs. A memory-mapped file on a
# disk-backed filesystem is a page fault in whatever path touches it, and the
# run root is on the ESSD. `CLUSTER_RUN_ROOT` is fine for the archive and the
# cluster directory -- those have to survive the run -- but not for this.
CLUSTER_AERON_ROOT=${CLUSTER_AERON_ROOT:-/dev/shm/deepbook}

# Cores, sixteen per machine, one thread each.
CLUSTER_DRIVER_CONDUCTOR_CPU=${CLUSTER_DRIVER_CONDUCTOR_CPU:-1}
CLUSTER_DRIVER_SENDER_CPU=${CLUSTER_DRIVER_SENDER_CPU:-2}
CLUSTER_DRIVER_RECEIVER_CPU=${CLUSTER_DRIVER_RECEIVER_CPU:-3}
CLUSTER_CM_CPU=${CLUSTER_CM_CPU:-7}
CLUSTER_CONTAINER_CPU=${CLUSTER_CONTAINER_CPU:-8}
CLUSTER_GATEWAY_CPU=${CLUSTER_GATEWAY_CPU:-4}
CLUSTER_CLIENT_CPU=${CLUSTER_CLIENT_CPU:-6}

# The driver's threading mode. `DEDICATED` needs three cores of its own and is
# what the sixteen-core machines can afford; `SHARED` is what the eight-core
# single-machine bench uses, and is kept so a cell can be compared with it.
CLUSTER_THREADING_MODE=${CLUSTER_THREADING_MODE:-DEDICATED}

# The cluster's own timing. `2s` is what the single-machine failover run uses;
# the product default is 10s. Whatever it is, `gateway_new_leader_ms` must be
# longer than the election it produces -- the failover run has been measured at
# 4.2-4.5 s with 2 s here, and the gateway's own default is 4 s.
CLUSTER_HEARTBEAT=${CLUSTER_HEARTBEAT:-2s}
CLUSTER_ELECTION_TIMEOUT=${CLUSTER_ELECTION_TIMEOUT:-250ms}
CLUSTER_GATEWAY_NEW_LEADER_MS=${CLUSTER_GATEWAY_NEW_LEADER_MS:-15000}
# The follower driver's image liveness (`aeron.image.liveness.timeout`). The
# build's default is 10 s, and a measured failover on 2026-11-04 shows the
# survivors do not move at all for ~13.6 s after the leader dies -- regardless
# of `CLUSTER_HEARTBEAT` -- which points at this. Empty keeps the default.
CLUSTER_IMAGE_LIVENESS=${CLUSTER_IMAGE_LIVENESS:-}

# ★ The leader is appointed, not elected. node0 is also the controller, and on
# these four machines a cell whose leader is on node0 reads 8-15% slower -- the
# same grid, the same arm, only the leader's host changed (2026-11-04,
# `analysis/cluster/conclusions-2026-11-04-leader-host.md` §1). An elected
# leader would put that variable into every reading and, worse, move it between
# cells. Empty = elected, which is the right setting only for a failover run
# that is *testing* the election -- and it must be set empty explicitly
# (`CLUSTER_APPOINTED_LEADER=`), which is why the default uses `-` and not `:-`:
# with `:-` an explicit empty would silently come back as 1.
CLUSTER_APPOINTED_LEADER=${CLUSTER_APPOINTED_LEADER-1}

# The engine, identical on every member.
CLUSTER_ENGINE_SYMBOL=${CLUSTER_ENGINE_SYMBOL:-1}
CLUSTER_ENGINE_MAX_ORDERS=${CLUSTER_ENGINE_MAX_ORDERS:-1048576}
CLUSTER_ENGINE_RECENT_WINDOW=${CLUSTER_ENGINE_RECENT_WINDOW:-1000000}
