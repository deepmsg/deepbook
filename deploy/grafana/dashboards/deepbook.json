  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Benchmark RTT (client, first report)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "\u00b5s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "deepbook_bench_rtt_p50_us",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "deepbook_bench_rtt_p90_us",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "deepbook_bench_rtt_p99_us",
          "legendFormat": "p99"
